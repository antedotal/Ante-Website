{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Preserve the existing Worker identity while explicitly routing both production hosts.
  "name": "ante-website-backend-preview",
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Preserve the current operational endpoint; account-origin checks still deny noncanonical hosts.
  "workers_dev": true,
  "routes": [
    { "pattern": "antedotal.com/*", "zone_name": "antedotal.com" },
    { "pattern": "www.antedotal.com/*", "zone_name": "antedotal.com" }
  ],
  "preview_urls": false,
  "vars": {
    // Admission trusts only genuine Cloudflare visitor metadata; persist this nonsecret deployment prerequisite.
    "ANTE_AUTH_INGRESS": "cloudflare"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Host canonicalization must run even for existing static asset paths.
    "run_worker_first": true
  },
  "services": [
    {
      // OpenNext uses its own Worker for internal server calls.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ante-website-backend-preview"
    }
  ]
}
