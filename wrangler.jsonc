{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keep the backend artifact distinct from the live Pages project.
  "name": "ante-website-backend-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Local preview remains available, but deployment creates no public URL or route.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext uses its own Worker for internal server calls.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ante-website-backend-preview"
    }
  ]
}
