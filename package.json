    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.106.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.2",
    "lenis": "^1.1.20",
    "lucide-react": "^0.562.0",
    "motion": "^12.24.10",
    "next": "16.3.3",
    "ogl": "^1.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "supabase": "^2.72.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "stripe": "23.0.0"
