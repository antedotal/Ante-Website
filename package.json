{
  "name": "ante-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:acceptance:local": "node --test --test-concurrency=1 scripts/acceptance/hosted-account-jwt.test.mjs scripts/acceptance/hosted-account-jwt-sql.test.mjs scripts/acceptance/hosted-profile-photo-readers.test.mjs scripts/acceptance/hosted-profile-photo-readers-port.test.mjs scripts/acceptance/hosted-profile-photo-readers-sql.test.mjs scripts/acceptance/hosted-profile-photo-mediated.test.mjs scripts/acceptance/hosted-profile-photo-mediated-http.test.mjs scripts/acceptance/hosted-profile-photo-mediated-cleanup.test.mjs scripts/acceptance/hosted-profile-photo-mediated-sql.test.mjs scripts/acceptance/hosted-profile-photo-mediated-port.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:acceptance:mediated": "node --test --test-concurrency=1 scripts/acceptance/hosted-profile-photo-mediated.test.mjs scripts/acceptance/hosted-profile-photo-mediated-http.test.mjs scripts/acceptance/hosted-profile-photo-mediated-cleanup.test.mjs scripts/acceptance/hosted-profile-photo-mediated-sql.test.mjs scripts/acceptance/hosted-profile-photo-mediated-port.test.mjs"
  },
