    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "rclone.js": "0.6.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "3.2.4",
    "wrangler": "4.139.0"
  },
  "description": "The website for our procrastination friends",
